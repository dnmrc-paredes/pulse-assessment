// Pulse — coordination store only. Nothing here is durable user data:
// rows are deleted on leave, on staleness, or after a signal is delivered.
// Chat text and video are NOT modeled — they ride WebRTC peer-to-peer and
// never reach the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Presence {
  // Server-issued session id. This is the *public* address of a session: peers
  // learn it (they must, to route signals) but it grants nothing on its own.
  id String @id

  // SHA-256 of the session's secret token. The token itself is never stored,
  // so a database leak cannot be replayed as a live session. Every mutating
  // request resolves identity by looking up this hash — never by trusting a
  // client-supplied id.
  tokenHash String @unique

  lat Float // ALREADY privacy-offset coords (raw is never stored)
  lng Float

  // Busy is a *lease*, not a latch: busyAt is stamped when the lock is taken
  // and refreshed by the holder while the connection is live. A lock whose
  // busyAt has aged past BUSY_TTL_MS is reclaimed by /api/poll, so a crashed
  // or half-closed connection can never lock a user out permanently.
  busy   Boolean   @default(false)
  busyAt DateTime?

  lastSeen DateTime

  @@index([lastSeen])
  // Supports the expired-lease sweep in /api/poll.
  @@index([busy, busyAt])
}

enum SignalType {
  wave
  request
  accept
  decline
  offer
  answer
  ice
  end
}

model Signal {
  // Mailbox for connection requests + WebRTC signaling only.
  id        String     @id @default(uuid())
  toId      String // recipient session id
  fromId    String // sender session id
  type      SignalType
  payload   String? // JSON string (SDP / ICE candidate)
  createdAt DateTime   @default(now())

  // Inbox read: "give me my signals oldest-first, live ones only".
  @@index([toId, createdAt])
  // /api/leave scans by sender as well as recipient.
  @@index([fromId])
  // Orphan reaper in /api/poll scans by age across the whole table.
  @@index([createdAt])
}
